// Stones4U Control Center — central data model (Phase 1)
//
// Shopify remains the commercial source of truth for customer identity
// (name, email, phone, addresses, orders) — see docs/architecture/ADR-002.
// CustomerProfile is a thin, Control-Center-owned record keyed by a stable
// Shopify Customer GID, carrying only CRM-specific data (status, account
// manager, tags) plus a denormalized snapshot for fast search/display.
//
// Task and Note are new, centrally-owned models (docs/architecture/ADR-003)
// — not a reuse of TelefoonSysteem's Task/Note tables. See
// docs/platform-discovery/21-TASKS-NOTES-REUSE-ANALYSIS.md for the referenced
// (not copied) business rules.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  VIEWER
}

enum CrmStatus {
  LEAD
  ACTIVE
  INACTIVE
  AT_RISK
  VIP
}

// Phase 5a — docs/architecture/ADR-011-CUSTOMER-IDENTITY-TYPE.md. Only ever
// used as an explicit human override (CustomerProfile.customerTypeOverride)
// — the derived value is never persisted, see effectiveCustomerType().
enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A > B split per docs/platform-discovery/24: CONTROL_CENTER activities are
// owned rows in this database; all other sourceTypes are external/projected
// — see src/modules/activity for the adapter/projection layer that renders
// non-CONTROL_CENTER activity from source data without duplicating storage,
// with the sole current exception of Shopify orders (fetched live and
// projected into the timeline without ever being persisted here either).
enum ActivitySourceType {
  CONTROL_CENTER
  SHOPIFY
  TELEFOONSYSTEEM
  EXACT
}

enum ActivityType {
  NOTE_CREATED
  NOTE_UPDATED
  NOTE_DELETED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_CANCELLED
  CUSTOMER_PROFILE_UPDATED
  SHOPIFY_ORDER
  CALL
  INVOICE
  // Phase 2
  FILE_UPLOADED
  FILE_REMOVED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_CANCELLED
  TASK_UPDATED
  TASK_COMMENT_ADDED
  TASK_CHECKLIST_COMPLETED
  // Phase 3 — docs/architecture/ADR-008-EXTERNAL-COMMUNICATIONS-STRATEGY.md.
  // All category B (live-projected, never persisted as an Activity row) —
  // only DRAFT_ORDER_CREATED has an actual Phase 3a producer
  // (src/integrations/shopify/draft-orders.ts); the rest are added now so
  // the enum never needs a second migration cycle once telephony/email/
  // quotes adapters land in Phase 3b/3c (docs/platform-discovery/29-PHASE-3-BUILD-SPEC.md §3).
  CALL_INBOUND
  CALL_OUTBOUND
  CALL_MISSED
  EMAIL_INBOUND
  EMAIL_OUTBOUND
  QUOTE_CREATED
  QUOTE_UPDATED
  DRAFT_ORDER_CREATED
  // Phase 4a — docs/architecture/ADR-009-OPPORTUNITY-PIPELINE-MODEL.md.
  // Control-Center-owned (category A per ADR-008), same as TASK_*/NOTE_*.
  OPPORTUNITY_CREATED
  OPPORTUNITY_STAGE_CHANGED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  OPPORTUNITY_REOPENED
  // Phase 7 — docs/QUOTE-DELIVERY-DATE-PORTAL-BUILD.md. Category A
  // (Control-Center-owned row): the customer's chosen date is captured and
  // persisted here, even though the submitting actor is the customer, not
  // staff (Activity.actorId is nullable — same precedent already used by
  // AuditEvent.userId). Written only on the public /delivery/[token] POST
  // when requestedDeliveryDate is set for the first time or genuinely
  // changes — never on a same-date resubmit (no timeline spam) and never
  // on a plain GET.
  DELIVERY_DATE_REQUESTED
}

// Phase 2 — docs/platform-discovery/26-PHASE-2-BUILD-SPEC.md
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(AGENT)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  tasksCreated     Task[]            @relation("TasksCreated")
  tasksAssigned    Task[]            @relation("TasksAssigned")
  notesAuthored    Note[]
  auditEvents      AuditEvent[]
  activities       Activity[]
  managedCustomers CustomerProfile[] @relation("AccountManager")

  // Phase 2
  taskComments         TaskComment[]
  appointmentsAssigned Appointment[]           @relation("AppointmentsAssigned")
  appointmentsCreated  Appointment[]           @relation("AppointmentsCreated")
  filesUploaded        File[]
  customerTagsCreated  CustomerTag[]
  tagAssignmentsMade   CustomerTagAssignment[]

  // Phase 3a
  confirmedMatches ExternalContactMatch[]

  // Phase 4a
  opportunitiesOwned   Opportunity[]             @relation("OpportunityOwner")
  opportunitiesCreated Opportunity[]             @relation("OpportunityCreatedBy")
  opportunityLinksMade OpportunityExternalLink[] @relation("OpportunityLinksMade")

  // Phase 4c
  customerContactsCreated CustomerContact[]

  // Phase 6d
  notesPinned Note[] @relation("NotesPinned")

  // Phase 7 — docs/QUOTE-DELIVERY-DATE-PORTAL-BUILD.md
  deliveryDateHandoffsCreated DeliveryDateHandoff[]

  @@index([role])
}

// Server-side session record — deliberately DB-backed (not a stateless JWT),
// so a session can be revoked instantly. See docs/platform-discovery/14 and
// 19 for why TelefoonSysteem's stateless-JWT approach was not repeated here.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// The Control Center's own, thin customer record. Shopify remains the
// commercial identity source (name/email/phone/addresses/orders) — this
// model exists only to carry CRM-specific ownership and a stable local id
// that Note/Task/Activity can point to. shopifyCustomerGid is the one
// required, unique link back to Shopify (docs/architecture/ADR-002).
model CustomerProfile {
  id                 String    @id @default(cuid())
  shopifyCustomerGid String    @unique
  // Denormalized snapshot for fast local search — refreshed opportunistically
  // whenever the profile is loaded from Shopify; never the source of truth.
  displayName        String?
  companyName        String?
  email              String?
  phone              String?
  phoneNormalized    String?
  crmStatus          CrmStatus @default(LEAD)
  accountManagerId   String?
  accountManager     User?     @relation("AccountManager", fields: [accountManagerId], references: [id])
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Phase 5a — docs/architecture/ADR-011-CUSTOMER-IDENTITY-TYPE.md. Both
  // Control-Center-owned, never touched by the Shopify sync. Null override
  // means "derive from companyName" (see effectiveCustomerType() in
  // src/modules/crm/customer-identity.ts) — this is NOT the same as
  // "INDIVIDUAL"; a genuinely-derived INDIVIDUAL and an unset override both
  // read as null here, which is intentional (ADR-011 §1).
  customerTypeOverride CustomerType?
  // Guards companyName against being overwritten by the next Shopify sync
  // once a human has explicitly set/confirmed it (ADR-011 §2).
  companyNameConfirmed Boolean       @default(false)

  notes           Note[]
  tasks           Task[]
  activities      Activity[]
  // Phase 2 — replaces the never-populated Phase-1 `tags String[]` field
  // (no tag UI ever existed to write it, see docs/platform-discovery/26 §3)
  // with a real, reusable, relational tag model.
  tagAssignments  CustomerTagAssignment[]
  files           File[]
  appointments    Appointment[]
  // Phase 3a
  externalMatches ExternalContactMatch[]
  // Phase 4a
  opportunities   Opportunity[]
  // Phase 4c
  contacts        CustomerContact[]
  // Phase 7 — docs/QUOTE-DELIVERY-DATE-PORTAL-BUILD.md
  deliveryDateHandoffs DeliveryDateHandoff[]

  @@index([phoneNormalized])
  @@index([email])
  @@index([crmStatus])
}

// Control-Center-owned person record for a business relationship at a
// CustomerProfile (docs/architecture/ADR-010-CUSTOMER-CONTACT-MODEL.md,
// docs/platform-discovery/38-PHASE-4C-CONTACTS-ARCHITECTURE.md §2). Never a
// mirror of Shopify data (§14/ADR-010 §5) — a person is only ever recorded
// here because a human explicitly added them. Belongs to exactly one
// CustomerProfile (no many-to-many — architecture doc §1). Deliberately no
// firstName/lastName split, no separate mobile/landline fields, no
// `department` column, no free-text `notes` column — see architecture doc
// §2 for why each was considered and rejected; contact-specific free text
// belongs on Note (via Note.customerContactId) instead.
model CustomerContact {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  displayName String
  jobTitle    String?

  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?

  // Booleans, not a role enum (architecture doc §8) — the three are not
  // mutually exclusive (an owner is often also the decision-maker and the
  // billing contact at a small business) and jobTitle already covers
  // free-text role description.
  isPrimary        Boolean @default(false)
  isDecisionMaker  Boolean @default(false)
  isBillingContact Boolean @default(false)

  // Soft-archive, never hard delete — unlike Opportunity (no restore path
  // yet, Phase 4A), CustomerContact gets an explicit restore: archiving a
  // contact is data-hygiene, not a commercial state transition, so a
  // low-risk "oops" recovery is warranted (architecture doc §15, confirmed
  // by Fons in the Phase 4C build instruction §0/A).
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  externalMatches ExternalContactMatch[]
  appointments    Appointment[]
  tasks           Task[]
  notes           Note[]
  // NOTE: a partial unique index enforcing "at most one active primary
  // contact per customer" (WHERE isPrimary = true AND archivedAt IS NULL)
  // also exists on this table, added directly in
  // prisma/migrations/20260903174521_phase_4c_customer_contacts/migration.sql
  // — Prisma's schema DSL has no WHERE-clause support for @@unique, so it
  // is intentionally NOT declared here. Do not "fix" this by running
  // `prisma db push` or regenerating this migration; both would try to
  // reconcile the schema back to having no such index. See
  // customer-contact.service.ts's setPrimaryContact() for how the service
  // layer's $transaction and this DB constraint work together
  // (transaction handles the normal case, the constraint closes the
  // remaining true-concurrency race).

  @@index([customerProfileId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([customerProfileId, archivedAt])
}

// Centrally-owned CRM note (docs/architecture/ADR-003). Structured body
// (bodyJson, a small constrained node-tree — see
// src/platform/security/rich-text.ts) so a future rich renderer never has to
// interpret raw HTML. bodyText is a always-derived plain-text projection,
// kept for search/preview. Unlike TelefoonSysteem's CallNote/ContactNote,
// notes here are editable and soft-deletable, both audited.
model Note {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  authorId          String
  author            User            @relation(fields: [authorId], references: [id])
  bodyJson          Json
  bodyText          String          @db.Text
  tags              String[]        @default([])
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Phase 4a — optional, same derivation invariant as Task.opportunityId.
  opportunityId     String?
  opportunity       Opportunity?     @relation(fields: [opportunityId], references: [id])
  // Phase 4c — optional. When set, the service layer verifies
  // customerContact.customerProfileId equals this Note's own
  // customerProfileId, never independently trusted from a caller (build
  // spec §20/§21, same invariant style as opportunityId above).
  customerContactId String?
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id])

  // Phase 6d — additive, backward-compatible pinning metadata
  // (docs/platform-discovery/54/55). isPinned drives sorting/filtering;
  // pinnedAt orders within the pinned group; pinnedById is presentation-
  // only context ("vastgezet door X"), separate from authorId — pinning
  // never changes who wrote the note. No onDelete override on pinnedBy —
  // Prisma generates ON DELETE SET NULL for this optional relation by
  // default (verified in the generated migration; identical to the
  // existing CustomerProfile.accountManagerId FK), so deleting a User can
  // never delete or block deleting a Note, only null this one field.
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?     @relation("NotesPinned", fields: [pinnedById], references: [id])

  activities Activity[]

  @@index([customerProfileId])
  @@index([authorId])
}

// Centrally-owned Task (docs/architecture/ADR-003). Relations beyond
// customerProfileId are prepared for later phases (Phase 3-6) and are
// intentionally unused/unenforced in Phase 1 business logic.
model Task {
  id                String           @id @default(cuid())
  title             String
  description       String?          @db.Text
  status            TaskStatus       @default(OPEN)
  priority          TaskPriority     @default(NORMAL)
  assignedToId      String
  assignedTo        User             @relation("TasksAssigned", fields: [assignedToId], references: [id])
  createdById       String
  createdBy         User             @relation("TasksCreated", fields: [createdById], references: [id])
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  // Phase 4a — optional. When set, customerProfileId is always derived from
  // Opportunity.customerProfileId by the service layer, never independently
  // trusted from a caller (ADR-009 §5, docs/platform-discovery/33 §build
  // spec — the exact invariant this column exists to support).
  opportunityId     String?
  opportunity       Opportunity?     @relation(fields: [opportunityId], references: [id])
  // Phase 4c — optional, same derivation/verification invariant as Note's
  // customerContactId (build spec §20): when both opportunityId and
  // customerContactId are set, they must imply the same CustomerProfile.
  customerContactId String?
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id])

  // Prepared for later phases (docs/platform-discovery/25 §4) — not read or
  // written by any Phase 1 code path.
  shopifyOrderGid String?
  quoteRef        String?
  callRef         String?
  supplierId      String?
  purchaseOrderId String?
  productionJobId String?
  complaintId     String?

  dueAt       DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Phase 2 — additive; a pre-existing Phase-1 task simply has an empty
  // tags array, no comments, and no checklist items (full backwards
  // compatibility, see docs/platform-discovery/26 §4).
  tags           String[]            @default([])
  reminderAt     DateTime?
  comments       TaskComment[]
  checklistItems TaskChecklistItem[]

  activities Activity[]

  @@index([assignedToId])
  @@index([createdById])
  @@index([customerProfileId])
  @@index([status])
  @@index([dueAt])
}

// Append-only task updates/comments (docs/platform-discovery/26 §3) — no
// edit/delete in Phase 2, mirroring TelefoonSysteem's TaskUpdate concept
// (referenced, not reused as code, per ADR-003).
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean   @default(false)
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
}

// Phase 2 — docs/platform-discovery/26-PHASE-2-BUILD-SPEC.md §3. externalId
// is prepared, unused in Phase 2 (no Microsoft Graph/Google Calendar sync
// yet — same "prepared field, no behavior" pattern as Task's Phase-1 fields).
model Appointment {
  id                 String            @id @default(cuid())
  customerProfileId  String
  customerProfile    CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  title              String
  description        String?           @db.Text
  startsAt           DateTime
  endsAt             DateTime?
  assignedToId       String
  assignedTo         User              @relation("AppointmentsAssigned", fields: [assignedToId], references: [id])
  createdById        String
  createdBy          User              @relation("AppointmentsCreated", fields: [createdById], references: [id])
  status             AppointmentStatus @default(SCHEDULED)
  externalCalendarId String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Phase 4a — optional, same derivation invariant as Task.opportunityId.
  opportunityId     String?
  opportunity       Opportunity?     @relation(fields: [opportunityId], references: [id])
  // Phase 4c — optional, same invariant style as Note/Task.
  customerContactId String?
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id])

  activities Activity[]

  @@index([customerProfileId])
  @@index([assignedToId])
  @@index([startsAt])
  @@index([status])
}

// Reusable Control Center CRM tags (docs/platform-discovery/26 §3) —
// distinct from any Shopify customer tag, never read from or written to
// Shopify.
model CustomerTag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  assignments CustomerTagAssignment[]
}

model CustomerTagAssignment {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  tagId             String
  tag               CustomerTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedById      String
  assignedBy        User            @relation(fields: [assignedById], references: [id])
  assignedAt        DateTime        @default(now())

  @@unique([customerProfileId, tagId])
  @@index([tagId])
}

// The unified Activity Timeline. sourceType = CONTROL_CENTER rows are
// created directly by this app's own actions (notes/tasks/profile changes —
// "A" activities per docs/platform-discovery/24). All other sourceType rows
// are NOT written by this schema in Phase 1 — Shopify orders, and any future
// TelefoonSysteem/Exact/email activity, are projected at render time by the
// adapters under src/integrations/*, never persisted here ("B" activities).
// This table therefore only ever contains CONTROL_CENTER-sourced rows today;
// the enum's other values exist so the timeline-rendering code has one
// shared shape, not because this table stores them.
model Activity {
  id                   String             @id @default(cuid())
  customerProfileId    String
  customerProfile      CustomerProfile    @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  type                 ActivityType
  sourceType           ActivitySourceType @default(CONTROL_CENTER)
  title                String
  summary              String?
  occurredAt           DateTime
  actorId              String?
  actor                User?              @relation(fields: [actorId], references: [id])
  relatedNoteId        String?
  relatedNote          Note?              @relation(fields: [relatedNoteId], references: [id])
  relatedTaskId        String?
  relatedTask          Task?              @relation(fields: [relatedTaskId], references: [id])
  // Phase 2
  relatedFileId        String?
  relatedFile          File?              @relation(fields: [relatedFileId], references: [id])
  relatedAppointmentId String?
  relatedAppointment   Appointment?       @relation(fields: [relatedAppointmentId], references: [id])
  // Phase 4a — fifth related*Id, same pattern as the four above.
  relatedOpportunityId String?
  relatedOpportunity   Opportunity?       @relation(fields: [relatedOpportunityId], references: [id])
  // Phase 7 — sixth related*Id, same pattern.
  relatedDeliveryDateHandoffId String?
  relatedDeliveryDateHandoff   DeliveryDateHandoff? @relation(fields: [relatedDeliveryDateHandoffId], references: [id])
  metadata             Json?
  createdAt            DateTime           @default(now())

  @@index([customerProfileId, occurredAt])
  @@index([relatedOpportunityId, occurredAt])
}

// Generic, append-only audit log — every mutating Control Center action
// writes one row here. Never logs secret values (see
// src/platform/audit/audit.ts).
model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// Cloudflare R2 object storage + Postgres metadata (docs/architecture/ADR-005,
// docs/platform-discovery/26 §10). Content lives only in R2, identified by
// the random, non-guessable storageKey — never derived from the original
// filename (src/integrations/storage/r2.ts). This table never held a real
// row before Phase 2 (schema-only in Phase 1), so this reshape is
// zero-data-risk — verified before migrating.
model File {
  id                String           @id @default(cuid())
  storageKey        String           @unique
  originalFilename  String
  mimeType          String
  byteSize          Int
  title             String?
  description       String?          @db.Text
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User             @relation(fields: [uploadedById], references: [id])
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Phase 4a — optional, same derivation invariant as Task.opportunityId.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  activities Activity[]

  @@index([customerProfileId])
}

// Phase 3a — docs/architecture/ADR-007-CUSTOMER-MATCHING-LAYER.md. Central
// matching layer used by every Phase 3 adapter (telephony, email, quotes) —
// no adapter implements its own matching logic. Never contains the external
// data itself (no call content, no email text, no quote detail), only the
// match relation. Deliberately usable end-to-end today even though
// TELEFOONSYSTEEM/GMAIL/OFFERTEAPP/S4U_QUOTE_APP have no live producer yet
// in Phase 3a (docs/platform-discovery/29-PHASE-3-BUILD-SPEC.md §1) — the
// model must be production-grade now, not a placeholder.
//
// GMAIL is legacy/unused — an earlier Phase 3c design assumed Gmail as the
// email source; that was corrected (docs/platform-discovery/30-PHASE-3C-EMAIL-INTEGRATION-DISCOVERY.md
// §6/§9) to a provider-independent EMAIL value instead (Microsoft 365 +
// IMAP both write EMAIL, never a provider-specific source — a customer's
// email address means the same thing regardless of which Stones4U mailbox
// observed it). GMAIL is kept, not removed, per that same correction — no
// row has ever referenced it.
enum MatchSource {
  TELEFOONSYSTEEM
  GMAIL
  EMAIL
  OFFERTEAPP
  S4U_QUOTE_APP
}

enum MatchMethod {
  PHONE
  EMAIL
  SHOPIFY_GID
  MANUAL
}

enum MatchConfidence {
  EXACT
  LIKELY
  MANUAL
  AMBIGUOUS
}

model ExternalContactMatch {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  source      MatchSource
  // Normalized phone number, normalized email address, or an external
  // record ID — meaning is source-dependent, always normalized via
  // src/lib/phone.ts / src/lib/email.ts before being stored here, never
  // the raw user-supplied string.
  externalRef String
  matchedBy   MatchMethod
  confidence  MatchConfidence

  // Null = system-suggested, not yet confirmed by a human. Set the moment
  // a human confirms an EXACT/LIKELY suggestion or creates a MANUAL link —
  // never set for an AMBIGUOUS row a human hasn't picked (ADR-007 rule 2).
  confirmedByUserId String?
  confirmedByUser   User?     @relation(fields: [confirmedByUserId], references: [id])
  // Soft-unlink — keeps the row (and its audit trail) instead of deleting,
  // hides it from active matching (ADR-007 rule 3).
  unlinkedAt        DateTime?

  // Phase 4c — optional person-level enrichment of an already
  // customer-level-resolved row (ADR-010 §2). Never part of the identity
  // key: the unique constraint below stays (customerProfileId, source,
  // externalRef), unchanged. onDelete: SetNull is defensive-only —
  // CustomerContact is never hard-deleted in practice (soft-archive only,
  // see CustomerContact.archivedAt) — but keeps this row intact rather
  // than cascading a delete into matching history if that invariant is
  // ever violated.
  customerContactId String?
  customerContact   CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerProfileId, source, externalRef])
  @@index([source, externalRef])
  @@index([customerContactId])
}

// Phase 3C-A — docs/platform-discovery/30-PHASE-3C-EMAIL-INTEGRATION-DISCOVERY.md
// §5. Provider-independent: which Stones4U mailboxes the EmailAdapter reads,
// and via which provider — never any credential. Microsoft 365 auth is a
// tenant-wide app credential (env vars, not a database row); IMAP auth (once
// built) is a server-side secret per mailbox — neither is ever stored here.
enum EmailProvider {
  MICROSOFT365
  IMAP
}

model MonitoredMailbox {
  id           String        @id @default(cuid())
  emailAddress String        @unique
  displayName  String?
  provider     EmailProvider
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Phase 4A — docs/architecture/ADR-009-OPPORTUNITY-PIPELINE-MODEL.md,
// docs/platform-discovery/33-PHASE-4A-BUILD-SPEC.md. `stage` and `status`
// are deliberately separate (ADR-009 §1): `stage` is the active funnel
// position, `status` is the lifecycle. A closed opportunity freezes `stage`
// at its last active value and never reuses WON/LOST as stage values.
enum OpportunityStage {
  NEW
  CONTACTED
  NEEDS_DEFINED
  QUOTE_PREPARATION
  QUOTE_SENT
  NEGOTIATION
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// Lightweight reference to an external commercial document — never a copy
// of the document itself (ADR-009 §4, same shape as ExternalContactMatch's
// externalRef in ADR-007). Always created/removed by a human
// (OpportunityExternalLink.linkedById), never by an automated process.
enum OpportunityLinkType {
  OFFERTEAPP_QUOTE
  S4U_QUOTE_APP_QUOTE
  SHOPIFY_DRAFT_ORDER
  SHOPIFY_ORDER
}

model Opportunity {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  title       String
  description String? @db.Text

  stage  OpportunityStage  @default(NEW)
  status OpportunityStatus @default(OPEN)

  // Decimal, never a JS float — see ADR-009 §6. No currency column: this
  // whole app is single-shop EUR (formatMoney() already assumes it), so a
  // column the UI never lets you change would be premature.
  estimatedValue    Decimal?  @db.Decimal(12, 2)
  finalValue        Decimal?  @db.Decimal(12, 2)
  // 0–100. Null = no explicit human value yet; the UI falls back to a
  // stage-default (architecture doc §14) for display/weighting only — that
  // default is never written back here (ADR-009: explicit human decisions
  // are never silently overwritten by a derived value).
  probability       Int?
  expectedCloseDate DateTime?

  ownerUserId String
  owner       User   @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  createdById String
  createdBy   User   @relation("OpportunityCreatedBy", fields: [createdById], references: [id])

  // "Sticky" historical timestamps — same precedent as Task.completedAt/
  // cancelledAt (task.service.ts updateTaskStatus): not cleared by a later
  // status change, so wonAt/lostAt always show the last time that state was
  // entered even after a reopen. lostReason IS cleared on reopen (a
  // re-opened deal has no current "reason it was lost" to display).
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?

  // Soft-close only — no hard delete, mirrors Note.deletedAt/
  // ExternalContactMatch.unlinkedAt (ADR-009 §7).
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  notes         Note[]
  appointments  Appointment[]
  files         File[]
  activities    Activity[]
  externalLinks OpportunityExternalLink[]

  @@index([customerProfileId])
  @@index([ownerUserId])
  @@index([status, stage])
  @@index([expectedCloseDate])
  @@index([archivedAt])
}

model OpportunityExternalLink {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  linkType    OpportunityLinkType
  // Meaning is linkType-dependent (offerte externalId or Shopify GID) —
  // never the external document itself, mirrors
  // ExternalContactMatch.externalRef (ADR-007).
  externalRef String

  linkedById String
  linkedBy   User      @relation("OpportunityLinksMade", fields: [linkedById], references: [id])
  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?

  @@unique([opportunityId, linkType, externalRef])
  @@index([linkType, externalRef])
}

// Phase 7 — docs/QUOTE-DELIVERY-DATE-PORTAL-BUILD.md. Native "Gewenste
// leverdatum klant" handoff. NEVER a copy of the external commercial
// document — same lightweight-reference pattern as
// OpportunityExternalLink/ExternalContactMatch (sourceSystem + externalId).
// Phase A only ever creates SHOPIFY-sourced rows (externalId =
// shopifyDraftOrderGid, the two happen to be identical today); OFFERTEAPP/
// S4U_QUOTE_APP are modeled now so a later phase that wires up the existing
// read-only quotes adapter (src/integrations/quotes/adapter.ts) never needs
// a second migration cycle for this — same "prepared, not yet producing"
// pattern already used for ActivityType's QUOTE_CREATED/QUOTE_UPDATED.
enum QuoteSourceSystem {
  SHOPIFY
  OFFERTEAPP
  S4U_QUOTE_APP
}

// Which payment engine this handoff will ultimately redirect to. Phase A
// only ever creates SHOPIFY rows — MOLLIE exists so the fail-closed "not
// supported yet" path (delivery-handoff.service.ts resolvePaymentTarget())
// has a real state to test against, not a hypothetical one; there is no
// Mollie integration anywhere in this repo (confirmed by repo-wide search
// during discovery) and building one is explicitly out of scope here.
enum PaymentProvider {
  SHOPIFY
  MOLLIE
  UNKNOWN
}

// Deliberately minimal — only states that represent real, observable system
// state (no fictitious PAID/COMPLETED without actual payment-completion
// feedback, which stays out of scope, see docs/QUOTE-DELIVERY-DATE-PORTAL-BUILD.md).
enum DeliveryDateHandoffStatus {
  PENDING // created, or a mirror attempt has not yet succeeded for the current requestedDeliveryDate
  MIRRORED // requestedDeliveryDate has been successfully written to Shopify's customAttributes
  ERROR // the most recent mirror attempt failed; requestedDeliveryDate is safely persisted locally regardless
}

// Phase 6B — which concrete Shopify commerce object externalId/the *Gid
// field actually points at. Explicit and typed on purpose: the GID string
// itself already encodes this ("gid://shopify/DraftOrder/…" vs
// "gid://shopify/Order/…"), but dispatch code must never infer behavior by
// string-matching an opaque external identifier — see
// docs/ORDER-DELIVERY-HANDOFF-FOUNDATION.md §"Data model decision" for the
// full comparison of alternatives this rejected. Defaults to
// SHOPIFY_DRAFT_ORDER so every historical Phase A row (created before this
// column existed) backfills unambiguously — never SHOPIFY_ORDER by
// accident.
enum DeliveryCommerceObjectType {
  SHOPIFY_DRAFT_ORDER
  SHOPIFY_ORDER
}

model DeliveryDateHandoff {
  id String @id @default(cuid())

  // Opaque public bearer token — only the HMAC-SHA256 hash is ever stored
  // (same technique as Session.tokenHash, src/platform/auth/session.ts),
  // never the raw token. See src/modules/delivery/token.ts for why a
  // dedicated field/secret was chosen over reusing the row's own cuid `id`
  // or SESSION_SECRET.
  publicTokenHash String @unique

  sourceSystem         QuoteSourceSystem
  // = shopifyDraftOrderGid OR shopifyOrderGid, whichever commerceObjectType
  // says this row is (sourceSystem is always SHOPIFY in Phase A/B) — kept
  // as its own field, not derived, so a future OFFERTEAPP/S4U_QUOTE_APP row
  // (externalId = that system's quote id) never has to change this
  // column's meaning. The existing @@unique([sourceSystem, externalId])
  // below already guarantees at most one handoff per Draft Order OR per
  // Order — Draft GIDs and Order GIDs never collide as strings, so no new
  // constraint was needed for Phase 6B.
  externalId           String
  commerceObjectType   DeliveryCommerceObjectType @default(SHOPIFY_DRAFT_ORDER)
  shopifyDraftOrderGid String?
  // Phase 6B — populated only for commerceObjectType = SHOPIFY_ORDER, null
  // for every historical Draft-based row (never backfilled/derived).
  shopifyOrderGid      String?
  // Phase 6B — a customer-safe, human-readable reference ("#1234"),
  // captured once at handoff creation from Shopify's own order/draft name.
  // Never a GID, never PII, never fabricated when unavailable. Exists so
  // the public page (Phase 6D) never needs its own Shopify read just to
  // show "Bestelling #1234". Null for every historical row — intentionally
  // never backfilled.
  publicReference      String?

  // Nullable — a handoff can be created before customer identity is
  // confidently resolved (ADR-002: Shopify is the identity source of
  // truth, not this row). Never required for the public flow to function.
  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id])

  // The customer's WISH, never a guarantee — never confused with a
  // transport-planning field. This repo has no transport/Hoefnagels module
  // today, so there is nothing yet to accidentally collide with; the
  // separation is a forward-looking design rule, not a fix for an existing
  // conflict.
  requestedDeliveryDate DateTime? @db.Date

  // Phase 6P — optional customer remark about the delivery (max 500 chars,
  // enforced server-side in delivery-details.ts). Plain text only: never
  // parsed as HTML/markdown, never mirrored to Shopify, and deliberately not
  // copied into AuditEvent metadata. Null for every historical row.
  deliveryComment String?
  // Phase 6P — did the customer confirm the location is reachable by a large
  // truck? `true` = confirmed, `false` = NOT confirmed (which is not a claim
  // of inaccessibility), `null` = never asked. Logistics information only:
  // it never blocks a submission and is not mirrored to Shopify.
  largeTruckAccessConfirmed Boolean?

  // Phase 6AI — the Stones4U fulfillment mode as resolved when this handoff
  // was created ("DELIVERY" / "CUSTOMER_PICKUP"). Stored so the staff list can
  // show Bezorgen/Afhalen without a Shopify call per row.
  //
  // It is a SNAPSHOT, never the authority: the public page and the submit
  // route both re-resolve the mode live from the Order, because an Order can
  // change between handoff creation and the customer opening the link. Null
  // for every historical row and never backfilled.
  fulfillmentMode String?

  paymentProvider PaymentProvider          @default(UNKNOWN)
  status          DeliveryDateHandoffStatus @default(PENDING)

  lastMirrorAt    DateTime?
  // Short category string only (e.g. "ACCESS_DENIED", "SHOP_MISMATCH",
  // "NETWORK_ERROR") — never a raw Shopify response body, never PII.
  mirrorErrorCode String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@unique([sourceSystem, externalId])
  @@index([customerProfileId])
  @@index([shopifyDraftOrderGid])
}

// Phase 6C — durable webhook-delivery idempotency, deliberately separate
// from DeliveryDateHandoff's own (sourceSystem, externalId) uniqueness:
// that constraint protects against a *second handoff row*, not against
// re-running business logic (eligibility evaluation, an Order re-read) for
// a webhook Shopify redelivers. Shopify's own guidance is to dedupe on
// X-Shopify-Webhook-Id (docs/ORDER-DELIVERY-HANDOFF-FOUNDATION.md
// §"Webhook intake"). status starts RECEIVED, moves to PROCESSED only
// after the full pipeline (HMAC → shop identity → topic → re-read →
// eligibility → optional handoff) completes without error, or FAILED on
// any transient error — FAILED is intentionally retryable (never a
// permanent poison record): the same (shopDomain, webhookId) redelivery
// finds the FAILED row and is allowed to reprocess.
enum ShopifyWebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model ShopifyWebhookEvent {
  id String @id @default(cuid())

  shopDomain String
  // Shopify's X-Shopify-Webhook-Id header — "a unique composite key for
  // each delivery that you use to identify and deduplicate individual
  // deliveries" (Shopify's own webhook docs). Never a client-supplied
  // value — always read server-side from the verified request header.
  webhookId  String
  // HTTP header value as-received (e.g. "orders/create" or "ORDERS_CREATE"
  // — exact format confirmed empirically during Phase 6C's live E2E, see
  // docs/ORDER-DELIVERY-HANDOFF-FOUNDATION.md). Stored verbatim for
  // observability, never used for anything beyond an equality check.
  topic      String

  status ShopifyWebhookEventStatus @default(RECEIVED)

  // Structured decision outcome — originally the Phase 6C eligibility
  // result, broadened in Phase 6F to the general delivery-request decision
  // (evaluateDeliveryRequestDecision(); `eligible` = `shouldRequest`,
  // `eligibilityReason` = the decision's `reason`, e.g.
  // "WAITING_FOR_PAYMENT"/"ALREADY_HAS_REQUESTED_DELIVERY_DATE"). Field
  // names kept as-is deliberately — this is the same "one technical
  // receipt row, no separate workflow table" design Phase 6C already
  // established (docs/ORDER-DELIVERY-HANDOFF-FOUNDATION.md §"Payment
  // trigger"), just now shared by ORDERS_CREATE and ORDERS_PAID rather
  // than a single topic. Populated once the pipeline reaches that step;
  // null while still RECEIVED or if HMAC/shop-identity/topic verification
  // rejected the request before ever reaching business logic (those
  // rejections are not persisted here at all — see the routes' own doc
  // comments for why).
  eligible         Boolean?
  eligibilityReason String?

  // The DeliveryDateHandoff created as a result, if the decision was ever
  // genuinely `shouldRequest = true` (still never happens as of Phase 6F —
  // see delivery-request-decision.ts's own doc comment).
  createdHandoffId String?

  // Short category string only, same discipline as
  // DeliveryDateHandoff.mirrorErrorCode — never a raw Shopify response
  // body, never PII, never a stack trace.
  errorSummary String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([shopDomain, webhookId])
  @@index([status])
}
