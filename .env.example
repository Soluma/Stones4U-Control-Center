# Stones4U Control Center — environment variables (NAMES only; never commit real values)

# --- App ---
NODE_ENV=development
APP_ENV=development

# --- Database ---
DATABASE_URL=

# --- Auth ---
# HMAC pepper mixed into the server-side session-token hash (defense-in-depth
# on top of the token's own 256-bit random entropy — see
# src/platform/auth/session.ts). REQUIRED when NODE_ENV=production (the app
# refuses to start a session flow without it); optional in development,
# where a clearly-insecure fallback is used with a one-time warning.
# Generate a long random value per environment, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# --- Shopify (client-credentials, per ADR-006) ---
# Create a custom app in Shopify Admin (Settings > Apps and sales channels > Develop apps)
# with the client-credentials grant enabled, then set these from that app's API credentials.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Live shop-identity guard (ADR-006 / platform-discovery/14 pattern A) — must equal the
# myshopifyDomain Shopify itself reports; every write (Phase 1 has none) is checked against this.
SHOPIFY_EXPECTED_MYSHOPIFY_DOMAIN=

# --- TelefoonSysteem adapter (disabled by default in Phase 1, see ADR-004) ---
# No safe machine-to-machine auth exists today (see docs/build/PHASE-1-IMPLEMENTATION-REPORT.md).
# These are read but the adapter stays disabled unless a proper service-auth mechanism exists.
TELEFOONSYSTEEM_API_BASE_URL=
TELEFOONSYSTEEM_SERVICE_TOKEN=

# --- Exact / customer-history adapter (disabled by default in Phase 1, see ADR-004) ---
EXACT_HISTORY_API_BASE_URL=
EXACT_HISTORY_SERVICE_TOKEN=
