# Stones4U Control Center — environment variables (NAMES only; never commit real values)

# --- App ---
NODE_ENV=development
APP_ENV=development

# --- Database ---
DATABASE_URL=

# --- Auth ---
# HMAC pepper mixed into the server-side session-token hash (defense-in-depth
# on top of the token's own 256-bit random entropy — see
# src/platform/auth/session.ts). REQUIRED when NODE_ENV=production (the app
# refuses to start a session flow without it); optional in development,
# where a clearly-insecure fallback is used with a one-time warning.
# Generate a long random value per environment, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# --- Shopify (client-credentials, per ADR-006) ---
# Create a custom app in Shopify Admin (Settings > Apps and sales channels > Develop apps)
# with the client-credentials grant enabled, then set these from that app's API credentials.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Live shop-identity guard (ADR-006 / platform-discovery/14 pattern A) — must equal the
# myshopifyDomain Shopify itself reports; every write (Phase 1 has none) is checked against this.
SHOPIFY_EXPECTED_MYSHOPIFY_DOMAIN=

# --- TelefoonSysteem adapter (Phase 3b — see docs/build/PHASE-3B-IMPLEMENTATION-REPORT.md) ---
# TelefoonSysteem exposes GET /integrations/control-center/calls, guarded by
# its own CRM_SERVICE_TOKEN (a credential minted on the TelefoonSysteem side,
# not shared with any other integration). Leave both unset to keep the
# adapter disabled (graceful degradation, never a crash).
TELEFOONSYSTEEM_API_BASE_URL=
TELEFOONSYSTEEM_SERVICE_TOKEN=

# --- OfferteApp quotes adapter (Phase 3b) ---
# OfferteApp exposes GET /api/integrations/control-center/quotes, guarded by
# its own CRM_SERVICE_TOKEN. Leave both unset to keep this source disabled.
OFFERTEAPP_API_BASE_URL=
OFFERTEAPP_SERVICE_TOKEN=

# --- s4u-quote-app quotes adapter (Phase 3b) ---
# s4u-quote-app exposes GET /api/integrations/control-center/quotes, guarded
# by its own CRM_SERVICE_TOKEN. Leave both unset to keep this source
# disabled. Independent from OfferteApp above — no shared credential, no
# shared code, two uncoupled quote sources (docs/platform-discovery/27 §4).
S4U_QUOTE_APP_API_BASE_URL=
S4U_QUOTE_APP_SERVICE_TOKEN=

# --- Exact / customer-history adapter (disabled by default, see ADR-004) ---
EXACT_HISTORY_API_BASE_URL=
EXACT_HISTORY_SERVICE_TOKEN=

# Cloudflare R2 object storage — optional until Files is enabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Leave empty for a bucket in R2's default jurisdiction. Set to
# "eu" for a bucket created under the EU jurisdiction (Cloudflare dashboard
# URL contains /r2/eu/buckets/...) — otherwise every request fails with
# NoSuchBucket even though the bucket genuinely exists, because the S3 API
# endpoint differs per jurisdiction (see src/integrations/storage/r2.ts).
R2_JURISDICTION=
